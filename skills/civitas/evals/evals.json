  "cases": [
    {
      "id": "civ-01",
      "category": "historical_analysis",
      "mode": "HISTORY",
      "prompt": "Why did the Western Roman Empire fragment while the Eastern half lasted another thousand years? Use CIVITAS.",
      "expected_properties": [
        "Separates attested facts (E1) from interpretations (E2)",
        "Applies at least two theories (e.g. SDT, Tainter, fiscal-military)",
        "Compares with a non-European case",
        "Notes 'fall vs transformation' debate",
        "Names discriminating evidence"
      ],
      "failure_conditions": [
        "Single-cause explanation",
        "Presents a theory as settled fact",
        "Only European analogues"
      ],
      "rubric": [
        {
          "criterion": "Historical accuracy",
          "scale": "0 absent / 1 partial / 2 full"
        },
        {
          "criterion": "Multi-causal mechanism",
          "scale": "0 absent / 1 partial / 2 full"
        },
        {
          "criterion": "Cross-regional comparison",
          "scale": "0 absent / 1 partial / 2 full"
        },
        {
          "criterion": "Tier honesty",
          "scale": "0 absent / 1 partial / 2 full"
        },
        {
          "criterion": "Discriminating evidence",
          "scale": "0 absent / 1 partial / 2 full"
        }
      ],
      "auto_checks": {
        "linter_must_pass": true
      }
