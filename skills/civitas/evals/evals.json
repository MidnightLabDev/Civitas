{
  "civitas_version": "1.0",
  "description": "Behavioural evaluation set for the CIVITAS skill. Each case lists expected properties, failure conditions and a 0-2 rubric per criterion. Grade with a human or a separate grader model; run scripts/lint_response.py as an automatic pre-check.",
  "grading": {
    "pass_threshold": "average >= 1.5 per criterion and no failure condition triggered and linter pass (where applicable)",
